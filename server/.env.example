TMDB_READ_TOKEN=
OMDB_API_KEY=

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Modelos de reserva se o principal estiver sobrecarregado (separados por vírgula)
GEMINI_MODELOS_RESERVA=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

SUPABASE_URL=
# anon / publishable key (a mesma do .env da raiz)
SUPABASE_ANON_KEY=
# service_role / secret key: acesso total, NUNCA coloque no .env da raiz
SUPABASE_SERVICE_ROLE_KEY=

# Trakt (opcional): séries relacionadas. Crie um app em https://trakt.tv/oauth/applications
# e copie só o Client ID (o Client Secret não é usado)
TRAKT_CLIENT_ID=

PORT=3001
FRONTEND_URL=http://localhost:5173

